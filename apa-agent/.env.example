# Diese Datei nach ".env" kopieren und den eigenen API-Key eintragen.
# Die .env-Datei NIE ins Git-Repository hochladen (steht in .gitignore).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Modell (günstiger: claude-haiku-5-5)
# APA_MODELL=claude-sonnet-5-5

# Optional: Denkaufwand (z. B. low, medium, high). Leer = Standard des Modells.
# APA_EFFORT=medium
